# =====================================================================
# dataquill 환경 변수 (로컬: 이 파일을 .env 로 복사해서 사용)
#   [LOCAL]   로컬 개발 전용 (배포 환경에는 등록하지 않음)
#   [RENDER]  Render 대시보드 > Environment 에 직접 등록
#   [RENDER-FE] Render 프런트엔드(Static Site) > Environment 에 등록
# 배포 도메인: 프런트 https://dataquill.onrender.com / 백엔드 https://dataquill-api.onrender.com
# 주의: 값 뒤에 주석을 붙이지 마세요. 빈 값 뒤의 주석은 값으로 읽힙니다.
# =====================================================================

# ---------- 공통 / 백엔드 ----------
# [LOCAL] local / [RENDER] production
APP_ENV=local
# [RENDER] JWT 서명 키 (반드시 긴 난수로 변경)
SECRET_KEY=change-me-to-a-long-random-string
# [RENDER]
JWT_EXPIRE_MINUTES=720

# [RENDER] 운영 관리자 계정 (/admin/login 또는 일반 로그인에서 같은 이메일·비밀번호로 접속).
#   ADMIN_PASSWORD 를 비우면 운영 관리자 로그인 비활성. 공개 테스트 계정 이메일과 겹치지 않게 할 것.
ADMIN_EMAIL=operator@dataquill.io
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=

# [RENDER] DB 접속 URL. 기본 SQLite, TiDB Cloud 사용 시 예 (TiDB 는 DB_SSL=true 필수):
#   mysql+pymysql://<user>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/dataquill
DATABASE_URL=sqlite:///./storage/dataquill.db
# [RENDER] TiDB Cloud 는 TLS 필수 -> true
DB_SSL=false
# [RENDER] CA 인증서 경로. 비우면 certifi CA 번들 사용
DB_SSL_CA=

# [LOCAL] 업로드 원본 저장 경로
STORAGE_DIR=./storage/uploads
# [RENDER] 테스트 계정(user@/admin@dataquill.io) 자동 생성 여부
SEED_TEST_ACCOUNTS=true

# [RENDER] https://dataquill.onrender.com
FRONTEND_URL=http://localhost:5173
# [RENDER] https://dataquill-api.onrender.com
BACKEND_URL=http://localhost:8000
# [RENDER] 쉼표로 구분, 프런트 도메인 필수
CORS_ORIGINS=http://localhost:5173,https://dataquill.onrender.com

# ---------- AI (Google Gemini) ----------
# [RENDER] 비우면 규칙 기반 파서로 대체
GEMINI_API_KEY=
# [RENDER]
GEMINI_MODEL=gemini-2.5-flash
# [RENDER] 주 모델 과부하 시 자동으로 바꿔 쓸 대체 모델 (비우면 대체 없음)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ---------- OAuth ----------
# 각 개발자 콘솔에 등록할 Redirect URI: {BACKEND_URL}/api/auth/oauth/{google|naver|kakao}/callback
# [RENDER]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [RENDER]
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# [RENDER] KAKAO_CLIENT_ID = REST API 키, CLIENT_SECRET 은 선택(보안 > Client Secret 사용 시)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---------- RPA ----------
# [LOCAL] Playwright 가 입력할 ERP 화면. 비우면 같은 서버의 데모 ERP(http://127.0.0.1:$PORT/erp-demo) 사용
# [RENDER] 데모 ERP 를 쓸 때는 등록하지 않음 (실제 ERP 연동 시에만 해당 URL 등록)
ERP_URL=http://localhost:8000/erp-demo
# [LOCAL] false 로 두면 브라우저 창을 띄워 타이핑 과정을 볼 수 있음
RPA_HEADLESS=true

# ---------- 프런트엔드 (Vite 는 VITE_ 접두사만 노출) ----------
# [RENDER-FE] https://dataquill-api.onrender.com / 비우면 목업(Mock) 모드로 동작
VITE_API_URL=http://localhost:8000
